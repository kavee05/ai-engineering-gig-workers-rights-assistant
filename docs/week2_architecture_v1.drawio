width="130" height="32" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Document Ingestion and&lt;br&gt;Version Register&lt;/b&gt;&lt;br&gt;Splits documents by&lt;br&gt;section and records each&lt;br&gt;version and access date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="250" height="120" as="geometry"/></mxCell><mxCell id="c54" value="NFR4, RAI4 (freshness)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="764" width="250" height="20" as="geometry"/></mxCell><mxCell id="c55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Official Public Sources&lt;/b&gt;&lt;br&gt;KESUMA Act 872 portal&lt;br&gt;(mohr.gov.my) and&lt;br&gt;PERKESO guidance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="270" height="120" as="geometry"/></mxCell><mxCell id="c57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="download" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#333