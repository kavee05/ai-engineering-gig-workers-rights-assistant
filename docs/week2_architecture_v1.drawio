<mxfile host="app.diagrams.net"><diagram id="v1" name="V1 Architecture"><mxGraphModel dx="1710" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1710" pageHeight="840" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Gig Workers Rights Assistant: V1 Conceptual Architecture" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="1710" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Components are labelled by function. Specific models, databases and frameworks will be chosen in later topics." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="52" width="1710" height="20" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="18" height="14" as="geometry"/></mxCell><mxCell id="c6" value="User interface" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="97" width="220" height="20" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="18" height="14" as="geometry"/></mxCell><mxCell id="c8" value="Data and knowledge" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="119" width="220" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="144" width="18" height="14" as="geometry"/></mxCell><mxCell id="c10" value="Model / AI capability" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="141" width="220" height="20" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="166" width="18" height="14" as="geometry"/></mxCell><mxCell id="c12" value="Scope and safety controls" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="163" width="220" height="20" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="30" y="188" width="18" height="14" as="geometry"/></mxCell><mxCell id="c14" value="Evaluation and monitoring" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="185" width="220" height="20" as="geometry"/></mxCell><mxCell id="c15" value="Italic text = requirements each component supports&lt;br&gt;Dashed = offline or background path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="208" width="320" height="32" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Gig Worker&lt;/b&gt;&lt;br&gt;p-hailing rider,&lt;br&gt;e-hailing driver or&lt;br&gt;freelancer on a phone&lt;br&gt;(BM, English or mixed)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Application Interface&lt;/b&gt;&lt;br&gt;Simple chat screen&lt;br&gt;Takes the question,&lt;br&gt;shows answer, source&lt;br&gt;and notice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c18" value="FR3, FR7" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="275" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Input Scope and&lt;br&gt;Safety Control&lt;/b&gt;&lt;br&gt;Checks scope, spots&lt;br&gt;legal advice requests,&lt;br&gt;masks personal data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c20" value="FR6, RAI2, RAI3, RAI5" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="520" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Knowledge Access&lt;/b&gt;&lt;br&gt;Finds the sections of&lt;br&gt;the Act and regulations&lt;br&gt;that match the question&lt;br&gt;(keeps section IDs)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c22" value="FR1, FR2, NFR1, NFR3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="765" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Language Model Service&lt;/b&gt;&lt;br&gt;Writes a short, plain&lt;br&gt;answer in the user's&lt;br&gt;language, only from&lt;br&gt;the retrieved sections" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c24" value="FR1, FR3, FR7, NFR5" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1010" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Output Grounding and&lt;br&gt;Citation Control&lt;/b&gt;&lt;br&gt;Checks cited sections&lt;br&gt;exist and support the&lt;br&gt;answer, no legal advice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1255" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c26" value="FR2, FR4, RAI2, RAI4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1255" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Response&lt;/b&gt;&lt;br&gt;Short answer, section&lt;br&gt;citation, document date,&lt;br&gt;next official step and&lt;br&gt;“not legal advice” notice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="175" height="130" as="geometry"/></mxCell><mxCell id="c28" value="FR2, FR5, FR7" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1500" y="464" width="175" height="20" as="geometry"/></mxCell><mxCell id="c29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="1. question" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="205" y="338" width="70" height="44" as="geometry"/></mxCell><mxCell id="c31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="2. question" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="450" y="338" width="70" height="44" as="geometry"/></mxCell><mxCell id="c33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="3. in scope&lt;br&gt;question" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fo