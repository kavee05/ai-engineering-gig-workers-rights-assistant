<mxfile host="app.diagrams.net"><diagram id="w3" name="Week 3 Pipeline"><mxGraphModel dx="1720" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value="Gig Workers Rights Assistant: Week 3 V1 Data Pipeline (as executed)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1720" height="30" as="geometry"/></mxCell><mxCell id="p3" value="Expands the green data components of the Week 2 V1 architecture: Official Public Sources, Document Ingestion and Version Register, Knowledge Source" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="46" width="1720" height="20" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style=&quot;font-size:14px&quot;&gt;From Week 2 V1 architecture&lt;/b&gt;&lt;br&gt;Official Public Sources, Document Ingestion and&lt;br&gt;Version Register, Knowledge Source (green boxes)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="420" height="70" as="geometry"/></mxCell><mxCell id="p5" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="86" width="16" height="13" as="geometry"/></mxCell><mxCell id="p6" value="Source" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="522" y="82" width="260" height="20" as="geometry"/></mxCell><mxCell id="p7" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="106" width="16" height="13" as="geometry"/></mxCell><mxCell id="p8" value="Data pipeline stage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="522" y="102" width="260" height="20" as="geometry"/></mxCell><mxCell id="p9" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="126" width="16" height="13" as="geometry"/></mxCell><mxCell id="p10" value="Validation and lineage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="522" y="122" width="260" height="20" as="geometry"/></mxCell><mxCell id="p11" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="146" width="16" height="13" as="geometry"/></mxCell><mxCell id="p12" value="Prepared output" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="522" y="142" width="260" height="20" as="geometry"/></mxCell><mxCell id="p13" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="166" width="16" height="13" as="geometry"/></mxCell><mxCell id="p14" value="Failure point and response" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="522" y="162" width="260" height="20" as="geometry"/></mxCell><mxCell id="p15" value="&lt;b style=&quot;font-size:14px&quot;&gt;1. SOURCE&lt;/b&gt;&lt;br&gt;KESUMA Act 872 portal&lt;br&gt;(mohr.gov.my)&lt;br&gt;&lt;br&gt;S01 Act 872, English, 59 pages&lt;br&gt;S02 P.U.(A) 143/2026, 3 pages&lt;br&gt;S03 FAQ, BM, 83 pages&lt;br&gt;(S03 inspected only)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p16" value="&lt;b style=&quot;font-size:14px&quot;&gt;2. INGEST&lt;/b&gt;&lt;br&gt;Notebook Cell 2&lt;br&gt;&lt;br&gt;Use PDFs uploaded to data/raw&lt;br&gt;(or download from official URL)&lt;br&gt;Rename from portal names&lt;br&gt;Check each file is a PDF&lt;br&gt;Log method, URL, size,&lt;br&gt;SHA-256, time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p17" value="&lt;b style=&quot;font-size:14px&quot;&gt;3. INSPECT&lt;/b&gt;&lt;br&gt;Step A3 (pypdf)&lt;br&gt;&lt;br&gt;Pages, characters,&lt;br&gt;empty pages, undecoded chars&lt;br&gt;Metadata: Act 872,&lt;br&gt;published 2025-12-31&lt;br&gt;2 sample pages per source" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p18" value="&lt;b style=&quot;font-size:14px&quot;&gt;4. PREPARE / TRANSFORM&lt;/b&gt;&lt;br&gt;Cells 5A1, 5A2, 8A&lt;br&gt;&lt;br&gt;Remove running headers&lt;br&gt;Skip pages 1 to 8&lt;br&gt;Normalise curly quotes&lt;br&gt;Read 112 official titles&lt;br&gt;Section aware split&lt;br&gt;(max 1,200 chars: subsection,&lt;br&gt;then paragraph)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p19" value="&lt;b style=&quot;font-size:14px&quot;&gt;5. VALIDATE OUTPUT&lt;/b&gt;&lt;br&gt;Step B3, Cell 8A&lt;br&gt;&lt;br&gt;File exists, not empty&lt;br&gt;All 112 sections found&lt;br&gt;Titles match contents pages&lt;br&gt;Every record has cite + page&lt;br&gt;Probe rules: s14(3), Reg 2&lt;br&gt;10 checks: all PASS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1150" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p20" value="&lt;b style=&quot;font-size:14px&quot;&gt;6. RECORD LINEAGE&lt;/b&gt;&lt;br&gt;Cells 6A, 6B, 8A, 9&lt;br&gt;&lt;br&gt;SHA-256 of sources and outputs&lt;br&gt;URL, version, rights note&lt;br&gt;week3_manifest.json&lt;br&gt;pipeline_manifest.json&lt;br&gt;Cell 9 rerun: outputs match" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1430" y="210" width="250" height="210" as="geometry"/></mxCell><mxCell id="p21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p15" target="p16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16" target="p17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17" target="p18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18" target="p19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19" target="p20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p27" value="&lt;b style=&quot;font-size:14px&quot;&gt;Part B comparison (same cleaned Act text)&lt;/b&gt;&lt;br&gt;Fixed 500 and paragraph aware 500: 141 chunks, 84 mix sections, no section label&lt;br&gt;Section aware (selected): 134 chunks, 0 mixed, every record citable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="860" y="86" width="540" height="70" as="geometry"/></mxCell><mxCell id="p28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p27" target="p18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Prepared records (JSONL)&lt;/b&gt;&lt;br&gt;134 Act records + 4 regulation records&lt;br&gt;Fields: cite, section, title, part,&lt;br&gt;pages, text, source URL, SHA-256&lt;br&gt;Full text kept private (git-ignored)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="520" width="280" height="120" as="geometry"/></mxCell><mxCell id="p30" value="&lt;b style=&quot;font-size:14px&quot;&gt;Public evidence on GitHub&lt;/b&gt;&lt;br&gt;Record ids, citations, pages,&lt;br&gt;SHA-256 of each record,&lt;br&gt;80 character preview,&lt;br&gt;both manifests" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1450" y="520" width="270" height="120" as="geometry"/></mxCell><mxCell id="p31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19" target="p29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p20" target="p30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33" value="&lt;b style=&quot;font-size:14px&quot;&gt;Next: Knowledge Source&lt;/b&gt;&lt;br&gt;feeds Knowledge Access (retrieval)&lt;br&gt;in later topics" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1140" y="695" width="280" height="70" as="geometry"/></mxCell><mxCell id="p34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p29" target="p33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35" value="&lt;b style=&quot;font-size:14px&quot;&gt;Failure point 1: source missing or changed&lt;/b&gt;&lt;br&gt;Download times out (happened in Colab), file is&lt;br&gt;not a PDF, or SHA-256 differs from the manifest&lt;br&gt;Response: stop and list the files to upload;&lt;br&gt;for a changed file keep the previous output&lt;br&gt;and reprocess as a new version (NFR4)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="500" width="330" height="170" as="geometry"/></mxCell><mxCell id="p36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.6;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35" target="p16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p37" value="&lt;b style=&quot;font-size:14px&quot;&gt;Failure point 2: Act structure not detected&lt;/b&gt;&lt;br&gt;Layout change or different text order&lt;br&gt;Detect: section count is not 112, titles do not&lt;br&gt;match the contents pages, or a heading is left&lt;br&gt;at the end of a section&lt;br&gt;Response: stop, never write wrong citations (FR2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="630" y="675" width="380" height="150" as="geometry"/></mxCell><mxCell id="p38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.6;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p37" target="p18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="460"/><mxPoint x="995" y="460"/></Array></mxGeometry></mxCell><mxCell id="p39" value="Also: scanned PDF with no text, stop at inspect (needs OCR)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="580" y="428" width="270" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>